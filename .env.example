# ---------------------------------------------------------------------------
# code-xplorer configuration
# Copy to .env and adjust. Every value below has a sensible local-first default,
# so the app runs out of the box with just `docker compose up -d` + Ollama.
# ---------------------------------------------------------------------------

# --- MongoDB (local Atlas via `docker compose up -d`) ---
# Any Atlas connection string also works (e.g. a cloud cluster).
MDB_URI=mongodb://localhost:27018/?directConnection=true
DB_NAME=code_search_db
COLLECTION_NAME=code_snippets

# --- Ollama (local, free, the default provider) ---
OLLAMA_HOST=http://localhost:11434
# Active embedding model. Format: "ollama/<model>" or "voyage/<model>".
EMBEDDING_MODEL=ollama/qwen3-embedding:4b
# Model that writes + verifies final answers.
LLM_MODEL=qwen3.6:27b
# Faster model used for indexing, planning, grading.
LLM_FAST_MODEL=qwen3:14b
# Upper bound on Ollama context window (keeps memory in check on laptops).
OLLAMA_NUM_CTX_CAP=16384
# How many retrieve -> grade -> expand loops the chat agent may run.
AGENT_MAX_ITERATIONS=3

# --- Voyage AI (optional upgrade) ---
# Set this to unlock Voyage code embeddings (voyage-code-3) and the rerank-2.5
# reranker in the model picker. Leave blank to stay fully local.
VOYAGE_API_KEY=

# --- Azure OpenAI (optional) ---
# Used as a chat provider only if all three of these are set.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- Flask ---
# 5001 by default: macOS uses port 5000 for the AirPlay Receiver.
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
